# Local development defaults. For production values see docs/deployment.md.

ENVIRONMENT=development
DEBUG=true

# SQLAlchemy + psycopg 3 URL. A bare postgres:// / postgresql:// URL (what
# Render and most managed hosts provide) is auto-normalized to the
# postgresql+psycopg:// driver scheme at load time, so DATABASE_URL from a
# managed provider can be used verbatim.
DATABASE_URL=postgresql+psycopg://clyra:clyra@localhost:5432/clyra

# Comma-separated list of allowed browser origins.
# Production: set this to the deployed Netlify URL (plus any custom domain).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

ANTHROPIC_API_KEY=
